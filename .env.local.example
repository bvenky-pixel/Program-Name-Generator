# Required for the OpenRouter path — get a key at https://openrouter.ai/keys.
# If unset (or if every OpenRouter model fails), generation falls back to a
# local Ollama server in this same container/machine, if one is running.
OPENROUTER_API_KEY=

# Optional — defaults shown
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
# OPENROUTER_MAX_TOKENS=8000
# LLM_TIMEOUT_MS=300000
# DB_PATH=./data/app.db

# Local Ollama fallback (used automatically if OpenRouter fails) — optional
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_TIMEOUT_MS=300000

# Only needed if you switch lib/search.ts to the Brave Search API fallback.
# BRAVE_API_KEY=
